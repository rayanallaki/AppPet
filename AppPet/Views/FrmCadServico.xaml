<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppPet.Views.FrmCadServico"
             Title="FrmCadServico"
             NavigationPage.HasNavigationBar="False">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="12">

        <VerticalStackLayout Spacing="12">
            <Label
                x:Name="lblPetSelecionado"
                FontAttributes="Bold" />

            <Label Text="Serviço:" />
            <Picker
                x:Name="pickerServico"
                Title="Selecione o serviço"
                SelectedIndexChanged="PickerServico_SelectedIndexChanged" />

            <Label Text="Descrição:" />
            <Entry x:Name="txtDescricao" />

            <Label Text="Valor:" />
            <Label x:Name="lblValorServico" Text="Selecione um serviço" />

            <Label Text="Duração:" />
            <Label x:Name="lblDuracaoServico" Text="Selecione um serviço" />

            <Button
                x:Name="btnSalvarServico"
                Text="Salvar serviço para o pet"
                IsEnabled="False"
                Clicked="ButtonSalvarServico" />
        </VerticalStackLayout>

        <Label
            Grid.Row="1"
            Text="LISTA DE SERVIÇOS"
            FontAttributes="Bold" />

        <CollectionView
            Grid.Row="2"
            x:Name="collectionViewServicos"
            EmptyView="Nenhum serviço cadastrado."
            ItemsSource="{Binding ServicosDoPet}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Stroke="Gray"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 5"
                        Padding="10"
                        Margin="0,0,0,8">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding Id, StringFormat='Serviço #{0}'}"
                                FontAttributes="Bold" />

                            <Label Text="{Binding Nome, StringFormat='Nome: {0}'}" />
                            <Label Text="{Binding Descricao, StringFormat='Descrição: {0}'}" />
                            <Label Text="{Binding Valor, StringFormat='Valor: R$ {0:F2}'}" />
                            <Label Text="{Binding DuracaoMinutos, StringFormat='Duração: {0} minutos'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
